# ============================================================
#  RepoInterview Trainer — variables de entorno
#  Copia este archivo como `.env.local` y completa los valores.
#  IMPORTANTE: estas variables solo se usan en el servidor (API routes).
#  Nunca se exponen al cliente ni al bundle.
# ============================================================

# --- Groq (obligatorio) ---
# Obtén tu API key gratis en: https://console.groq.com/keys
GROQ_API_KEY=

# Modelo principal (razonamiento — analiza código y evalúa respuestas).
# Deja el valor por defecto si no estás seguro.
GROQ_MODEL=openai/gpt-oss-120b

# Modelo de fallback (se usa si el principal falla o no está disponible).
GROQ_MODEL_FALLBACK=llama-3.3-70b-versatile

# --- SEO / redes sociales (opcional) ---
# URL pública del sitio, usada para las tarjetas Open Graph, el sitemap y el
# canonical. En Vercel se detecta sola (VERCEL_PROJECT_PRODUCTION_URL).
# Defínela solo si usas un dominio propio, p. ej. https://repointerview.com
NEXT_PUBLIC_SITE_URL=

# --- GitHub (opcional pero recomendado) ---
# Sin token, la API pública de GitHub limita a ~60 peticiones/hora por IP.
# Con un token (aunque sea sin permisos / "read-only public"), sube a ~5000/hora.
# Crea uno en: https://github.com/settings/tokens  (no requiere scopes para repos públicos)
GITHUB_TOKEN=
